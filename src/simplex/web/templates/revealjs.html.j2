<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
  <title>{{ deck.title }} -- slides</title>
  <link rel="stylesheet" href="{{ static_prefix }}/reveal.js/reset.css" />
  <link rel="stylesheet" href="{{ static_prefix }}/reveal.js/reveal.css" />
  <style>
    {{ palette_css|safe }}
  </style>
  <style>
    :root {
      --simplex-stage-bg: #2b2b2b;
      --simplex-stage-progress: rgba(255, 255, 255, 0.08);
    }
    :root[data-theme="light"] {
      --simplex-stage-bg: #f3f5f7;
      --simplex-stage-progress: rgba(21, 31, 40, 0.14);
    }
    html, body {
      background: var(--simplex-stage-bg);
      color: var(--simplex-text, #f8f8f8);
      height: 100%;
      width: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
      touch-action: manipulation;
    }
    .reveal, .reveal .slides {
      background: var(--simplex-stage-bg);
      width: 100% !important;
      height: 100% !important;
      inset: 0;
    }
    /* Override reveal's transform-based scaling: we want the video to fill
       the viewer box natively. Reveal still drives slide changes; only the
       layout math is ours. */
    .reveal .slides {
      top: 0 !important;
      left: 0 !important;
      transform: none !important;
      zoom: 1 !important;
    }
    .reveal .slides > section,
    .reveal .slides > section > section {
      position: absolute;
      inset: 0;
      width: 100% !important;
      height: 100% !important;
      padding: 0;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--simplex-stage-bg);
    }
    .reveal video {
      max-width: 100%;
      max-height: 100%;
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: var(--simplex-stage-bg);
      display: block;
    }
    .reveal .controls { display: none !important; }
    .reveal .progress {
      background: var(--simplex-stage-progress);
      height: 3px;
      color: var(--simplex-accent, #ffd700);
    }
    .reveal .progress span { background: var(--simplex-accent, #ffd700); }
    .tap-zone {
      position: fixed;
      top: 0;
      bottom: 0;
      width: 33vw;
      z-index: 30;
      background: transparent;
      border: 0;
      border-radius: 0;
      color: transparent;
      cursor: pointer;
      font-size: 0;
      margin: 0;
      padding: 0;
      appearance: none;
      -webkit-appearance: none;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .tap-zone.next { right: 0; width: 67vw; }
    .tap-zone.prev { left: 0; }
    @media (prefers-reduced-motion: reduce) {
      .reveal .slides section { transition: none !important; }
    }
    .empty-slide {
      font-family: var(--simplex-font-sans, ui-sans-serif, system-ui, sans-serif);
      font-size: 1.25rem;
      color: rgba(255,255,255,.65);
      padding: 2rem;
      text-align: center;
    }
    .simplex-chrome {
      position: fixed;
      z-index: 40;
      font-family: var(--simplex-font-sans, ui-sans-serif, system-ui, sans-serif);
      font-size: 1rem;
      color: var(--simplex-text-muted, rgba(255,255,255,.65));
      pointer-events: none;
    }
    .simplex-chrome.time-cluster {
      bottom: 10px;
      left: 10px;
      display: inline-flex;
      align-items: center;
      gap: .55rem;
    }
    .simplex-chrome.slide-number { bottom: 10px; right: 10px; }
    .simplex-chrome-item[hidden] { display: none !important; }
    .simplex-stopwatch {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      min-width: 5.2rem;
      box-sizing: border-box;
      padding: .18rem .48rem .2rem;
      border: 1px solid rgba(255, 255, 255, .16);
      border-radius: 999px;
      background: rgba(0, 0, 0, .32);
      color: var(--simplex-text, #fff);
      font-variant-numeric: tabular-nums;
      backdrop-filter: blur(8px);
    }
    :root[data-theme="light"] .simplex-stopwatch {
      border-color: rgba(21, 31, 40, .16);
      background: rgba(255, 255, 255, .72);
      color: var(--simplex-text, #1a1a1a);
    }
    .simplex-stopwatch::before {
      content: "";
      width: .42rem;
      height: .42rem;
      border-radius: 999px;
      background: var(--simplex-text-muted, rgba(255,255,255,.65));
      opacity: .55;
    }
    .simplex-stopwatch.is-running::before {
      background: var(--simplex-accent, #ffd700);
      opacity: 1;
    }
  </style>
  {% if deck_custom_css %}
  <style>
    {{ deck_custom_css|safe }}
  </style>
  {% endif %}
</head>
<body>
  <div class="reveal" role="region" aria-label="{{ deck.title }} slide viewer">
    <div class="slides">
      {% for main in main_slides %}
      <section
        data-main-index="{{ main.index }}"
        data-scene="{{ main.scene }}"
        data-name="{{ main.name }}"
      >
        {% for sub in main.subsections %}
        <section
          data-sub-name="{{ sub.name }}"
          {% if "loop" in sub.section_type %}data-background-video-loop{% endif %}
        >
          {% if sub.video_href %}
          <video
            data-autoplay
            muted
            playsinline
            preload="metadata"
            aria-label="{{ main.name }} - {{ sub.name }}"
          >
            <source src="{{ sub.video_href }}" type="video/mp4" />
          </video>
          {% else %}
          <div class="empty-slide">
            <p>{{ main.name }} - {{ sub.name }}</p>
            <p style="font-size:.85rem;opacity:.6">no video segment available</p>
          </div>
          {% endif %}
        </section>
        {% endfor %}
        {% if not main.subsections %}
        <section data-sub-name="empty">
          <div class="empty-slide">
            <p>{{ main.name }}</p>
            <p style="font-size:.85rem;opacity:.6">no rendered video for this slide yet</p>
          </div>
        </section>
        {% endif %}
      </section>
      {% endfor %}
    </div>
  </div>

  <button class="tap-zone prev" aria-hidden="true" tabindex="-1"
          data-tap="prev"></button>
  <button class="tap-zone next" aria-hidden="true" tabindex="-1"
          data-tap="next"></button>

  <div class="simplex-chrome time-cluster" id="simplex-time-cluster" aria-hidden="true">
    <span
      class="simplex-chrome-item clock"
      id="simplex-clock"
      {% if not show_clock %}hidden{% endif %}
    ></span>
    <span
      class="simplex-chrome-item simplex-stopwatch"
      id="simplex-stopwatch"
      {% if not show_stopwatch %}hidden{% endif %}
    >00:00:00</span>
  </div>
  <div
    class="simplex-chrome slide-number"
    id="simplex-slide-number"
    aria-hidden="true"
    {% if not show_slide_number %}hidden{% endif %}
  ></div>

  <script src="{{ static_prefix }}/reveal.js/reveal.js"></script>
  <script>
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const parentOrigin = (function () {
        try { return window.parent.location.origin || '*'; } catch (_) { return '*'; }
      })();
      const chromeState = {
        clock: {% if show_clock %}true{% else %}false{% endif %},
        slideNumber: {% if show_slide_number %}true{% else %}false{% endif %},
        stopwatch: {% if show_stopwatch %}true{% else %}false{% endif %},
      };
      const clockFormatter = new Intl.DateTimeFormat(undefined, {
        hour: 'numeric',
        minute: '2-digit',
        second: '2-digit',
      });
      const hourCycle = clockFormatter.resolvedOptions().hourCycle || '';
      const durationHourDigits = hourCycle === 'h11' || hourCycle === 'h12' ? 1 : 2;
      const stopwatchState = {
        elapsedMs: 0,
        startedAt: 0,
        running: false,
        timer: 0,
      };

      function formatDuration(ms) {
        const totalSeconds = Math.floor(Math.max(0, ms) / 1000);
        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        const hourText = String(hours).padStart(durationHourDigits, '0');
        return hourText + ':' + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
      }
      function stopwatchElapsed() {
        if (!stopwatchState.running) return stopwatchState.elapsedMs;
        return stopwatchState.elapsedMs + performance.now() - stopwatchState.startedAt;
      }
      function renderStopwatch() {
        const el = document.getElementById('simplex-stopwatch');
        if (!el) return;
        el.textContent = formatDuration(stopwatchElapsed());
        el.classList.toggle('is-running', stopwatchState.running);
      }
      function postStopwatchState() {
        try {
          window.parent.postMessage(
            {
              type: 'simplex.stopwatch-state',
              running: stopwatchState.running,
              elapsedMs: Math.floor(stopwatchElapsed()),
            },
            parentOrigin
          );
        } catch (_) { /* */ }
      }
      function scheduleStopwatchRender() {
        if (stopwatchState.timer) window.clearTimeout(stopwatchState.timer);
        renderStopwatch();
        if (stopwatchState.running) {
          stopwatchState.timer = window.setTimeout(scheduleStopwatchRender, 250);
        } else {
          stopwatchState.timer = 0;
        }
      }
      function toggleStopwatch() {
        if (stopwatchState.running) {
          stopwatchState.elapsedMs = stopwatchElapsed();
          stopwatchState.running = false;
        } else {
          stopwatchState.startedAt = performance.now();
          stopwatchState.running = true;
        }
        scheduleStopwatchRender();
        postStopwatchState();
      }
      function resetStopwatch() {
        stopwatchState.elapsedMs = 0;
        stopwatchState.startedAt = performance.now();
        scheduleStopwatchRender();
        postStopwatchState();
      }

      Reveal.initialize({
        embedded: true,
        controls: false,
        controlsTutorial: false,
        progress: true,
        hash: false,
        // Remap arrows to flat next/prev so direction never matters, even
        // when the slide grid has vertical sub-stops. Space is handled below
        // because it toggles media playback rather than advancing.
        keyboard: {
          37: 'prev', 38: 'prev', 33: 'prev',
          39: 'next', 40: 'next', 34: 'next',
        },
        // Disable Reveal's built-in swipe gestures. Mobile navigation goes
        // through the .tap-zone elements below; this keeps tap-right = next
        // and tap-left = prev regardless of horizontal/vertical slide layout.
        touch: false,
        transition: reduce ? 'none' : '{{ transition }}',
        backgroundTransition: 'none',
        autoPlayMedia: true,
        slideNumber: false,
        loop: false,
        center: false,
        // Reveal's scale-to-fit math fights us when the video already knows
        // its aspect; disableLayout: true means our CSS sizes every slide.
        disableLayout: true,
        viewDistance: 2,
      }).then(function () {
        function currentMainIndex() {
          // Resolve the active 1-based main-slide index from the closest
          // ancestor ``<section data-main-index>``. Works for both top-level
          // mains and their vertical sub-stops -- on a sub-slide the
          // closest() walk still lands on the surrounding main, so the
          // sidebar stays highlighted on the right thumbnail card while the
          // user scrubs through sub-stops.
          const slide = Reveal.getCurrentSlide();
          if (!slide) return 0;
          const main = slide.closest('[data-main-index]') || slide;
          const raw = main.getAttribute('data-main-index');
          return raw ? parseInt(raw, 10) || 0 : 0;
        }
        function currentSubIndex() {
          return Reveal.getIndices().v || 0;
        }
        function currentVideo() {
          return document.querySelector('.reveal .slides .present video');
        }
        function postPlayState(playing) {
          try {
            window.parent.postMessage(
              { type: 'simplex.play-state', playing: !!playing },
              parentOrigin
            );
          } catch (_) { /* */ }
        }
        function emit() {
          const idx = Reveal.getIndices();
          const total = {{ main_slide_count }};
          renderSlideNumber();
          try {
            window.parent.postMessage(
              {
                type: 'simplex.slide',
                idx: currentMainIndex(),
                sub: idx.v || 0,
                total: total,
              },
              parentOrigin
            );
          } catch (_) { /* parent gone or different origin */ }
        }
        function renderSlideNumber() {
          const el = document.getElementById('simplex-slide-number');
          if (!el) return;
          el.textContent = currentMainIndex() + ' / ' + {{ main_slide_count }};
        }
        function applyChrome() {
          const clock = document.getElementById('simplex-clock');
          const slideNumber = document.getElementById('simplex-slide-number');
          const stopwatch = document.getElementById('simplex-stopwatch');
          if (clock) clock.hidden = !chromeState.clock;
          if (slideNumber) slideNumber.hidden = !chromeState.slideNumber;
          if (stopwatch) stopwatch.hidden = !chromeState.stopwatch;
          renderSlideNumber();
          renderStopwatch();
        }
        function playCurrentVideoFromStart() {
          const v = currentVideo();
          if (!v) return;
          try { v.currentTime = 0; } catch (_) { /* */ }
          const p = v.play();
          if (p && typeof p.catch === 'function') p.catch(function () {});
        }
        function toggleCurrentVideo() {
          const v = currentVideo();
          if (!v) return;
          if (v.paused) {
            if (v.ended || v.currentTime >= Math.max(0, v.duration - 0.05)) {
              try { v.currentTime = 0; } catch (_) { /* */ }
            }
            const p = v.play();
            if (p && typeof p.catch === 'function') p.catch(function () {});
          } else {
            v.pause();
          }
          window.setTimeout(function () { postPlayState(!v.paused); }, 0);
        }
        function goToMain(idx) {
          const max = {{ main_slide_count }};
          if (idx < 1 || idx > max) return;
          Reveal.slide(idx - 1, 0);
        }
        function goToNextMain() {
          goToMain(currentMainIndex() + 1);
        }
        function goToPrevMainOrReset() {
          const main = currentMainIndex();
          if (main <= 0) return;
          if (currentSubIndex() > 0) {
            Reveal.slide(main - 1, 0);
            playCurrentVideoFromStart();
            window.setTimeout(playCurrentVideoFromStart, 50);
            return;
          }
          goToMain(main - 1);
        }
        Reveal.on('slidechanged', emit);
        Reveal.on('ready', emit);
        applyChrome();

        window.addEventListener('message', function (e) {
          const data = e.data || {};
          if (typeof data !== 'object') return;
          if (data.type === 'simplex.goto' && Number.isInteger(data.idx)) {
            // ``data.idx`` is the 1-based main-slide number from the sidebar
            // (``data-slide-target``). Reveal's horizontal index is 0-based,
            // so subtract one before dispatching.
            Reveal.slide(data.idx - 1, data.sub || 0);
          } else if (data.type === 'simplex.next') {
            Reveal.next();
          } else if (data.type === 'simplex.prev') {
            Reveal.prev();
          } else if (data.type === 'simplex.next-main') {
            goToNextMain();
          } else if (data.type === 'simplex.prev-main-or-reset') {
            goToPrevMainOrReset();
          } else if (data.type === 'simplex.restart') {
            const main = currentMainIndex();
            if (main > 0) Reveal.slide(main - 1, 0);
            playCurrentVideoFromStart();
            window.setTimeout(playCurrentVideoFromStart, 50);
          } else if (data.type === 'simplex.toggle-play') {
            toggleCurrentVideo();
          } else if (data.type === 'simplex.fullscreen') {
            const el = document.documentElement;
            const fn = el.requestFullscreen || el.webkitRequestFullscreen || el.mozRequestFullScreen;
            const exit = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen;
            const inFs = document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement;
            try {
              if (inFs) { if (exit) { exit.call(document); } }
              else if (fn) { fn.call(el); }
            } catch (_) { /* */ }
          } else if (data.type === 'simplex.set-chrome') {
            if (typeof data.clock === 'boolean') chromeState.clock = data.clock;
            if (typeof data.slideNumber === 'boolean') chromeState.slideNumber = data.slideNumber;
            if (typeof data.stopwatch === 'boolean') chromeState.stopwatch = data.stopwatch;
            applyChrome();
          } else if (data.type === 'simplex.stopwatch-toggle') {
            toggleStopwatch();
          } else if (data.type === 'simplex.stopwatch-reset') {
            resetStopwatch();
          } else if (data.type === 'simplex.set-theme' && typeof data.theme === 'string') {
            document.documentElement.dataset.theme = data.theme;
            document.documentElement.style.colorScheme = data.theme;
          }
        });

        document.addEventListener('keydown', function (ev) {
          const target = ev.target;
          if (
            target &&
            (target.tagName === 'INPUT' ||
              target.tagName === 'TEXTAREA' ||
              target.isContentEditable)
          ) return;
          if (ev.key === ' ' || ev.code === 'Space' || ev.key === 'Spacebar') {
            ev.preventDefault();
            ev.stopImmediatePropagation();
            toggleCurrentVideo();
            return;
          }
          if (!ev.ctrlKey || ev.altKey || ev.metaKey) return;
          if (ev.key === 'ArrowRight') {
            ev.preventDefault();
            ev.stopImmediatePropagation();
            goToNextMain();
          } else if (ev.key === 'ArrowLeft') {
            ev.preventDefault();
            ev.stopImmediatePropagation();
            goToPrevMainOrReset();
          }
        }, true);

        document.addEventListener('play', function (e) {
          if (!e.target || e.target.tagName !== 'VIDEO') return;
          postPlayState(true);
        }, true);
        document.addEventListener('pause', function (e) {
          if (!e.target || e.target.tagName !== 'VIDEO') return;
          postPlayState(false);
        }, true);

        let tapStart = null;
        let lastPointerTapAt = 0;
        function navigateTap(clientX) {
          if (clientX < window.innerWidth / 3) Reveal.prev();
          else Reveal.next();
        }
        document.addEventListener('pointerdown', function (ev) {
          if (!ev.isPrimary || ev.pointerType === 'mouse') return;
          tapStart = { x: ev.clientX, y: ev.clientY, t: Date.now() };
        }, { passive: true });
        document.addEventListener('pointerup', function (ev) {
          if (!tapStart || !ev.isPrimary || ev.pointerType === 'mouse') return;
          const dx = Math.abs(ev.clientX - tapStart.x);
          const dy = Math.abs(ev.clientY - tapStart.y);
          const dt = Date.now() - tapStart.t;
          tapStart = null;
          if (dx > 24 || dy > 24 || dt > 700) return;
          ev.preventDefault();
          lastPointerTapAt = Date.now();
          navigateTap(ev.clientX);
        }, { passive: false });
        document.querySelectorAll('.tap-zone').forEach(function (z) {
          z.addEventListener('click', function (ev) {
            ev.preventDefault();
            if (Date.now() - lastPointerTapAt < 350) return;
            if (z.dataset.tap === 'next') { Reveal.next(); }
            else { Reveal.prev(); }
          }, { passive: false });
        });
      });

      // Wall clock in the corner. Updates once per second; pad single
      // digits according to the user's locale / 12-24h system preference.
      (function () {
        const el = document.getElementById('simplex-clock');
        if (!el) return;
        const tick = () => {
          el.textContent = clockFormatter.format(new Date());
        };
        tick();
        setInterval(tick, 1000);
      })();

      renderStopwatch();

      {% if watch %}
      // --watch mode: subscribe to SSE for live reload on render.
      const es = new EventSource('/_simplex/events');
      es.addEventListener('reload', () => window.location.reload());
      {% endif %}
    })();
  </script>
</body>
</html>
